{
  "expo": {
    "name": "Mkulima",
    "slug": "mkulima-farmer",
    "version": "0.1.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2EEF6"
    },
    "scheme": "mkulima",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.mkulimascore.farmer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F2EEF6"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VISUAL_USER_SELECTED",
        "READ_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.mkulimascore.farmer",
      "supportsTablet": true,
      "requireFullScreen": false
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mkulima uses your location only when you choose to mark or walk your farm."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Mkulima uses the camera only when you choose to photograph a farm record.",
          "photosPermission": "Mkulima uses photos only when you choose to attach a farm record."
        }
      ],
      "expo-document-picker"
    ],
    "extra": {
      "appRole": "farmer"
    }
  }
}
