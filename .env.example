EXPO_PUBLIC_APP_MODE=demo
EXPO_PUBLIC_API_BASE_URL=https://api.mkulimascore.com
EXPO_PUBLIC_ENVIRONMENT=live-demo
# Staging farmer API (isolated from scores):
# EXPO_PUBLIC_APP_MODE=staging
# EXPO_PUBLIC_API_BASE_URL=https://v27oclbqdpqr576iubuqxdumpy0qlviw.lambda-url.us-east-1.on.aws
# After mkulimascore.com DNS hold is lifted, prefer https://staging-api.mkulimascore.com
EXPO_PUBLIC_BACKEND_FARMER_ID=
EXPO_PUBLIC_BACKEND_FARMER_MSID=

# Free/no-key AI mode:
# Keep EXPO_PUBLIC_APP_MODE=demo to use the built-in farmer-safe local assistant
# inside the mobile app. To test the no-key backend service, run:
# AUTH_MODE=development
# AI_PROVIDER=local
# npm run ai:dev
#
# Ask Mkulima production AI is served by:
# POST ${EXPO_PUBLIC_API_BASE_URL}/api/v1/farmer/ask-mkulima
# Do not place OpenAI, Bedrock, or other model-provider secrets in the mobile app.
