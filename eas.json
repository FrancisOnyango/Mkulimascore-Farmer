{
  "cli": {
    "version": ">= 21.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "image": "latest",
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_MODE": "demo"
      }
    },
    "staging": {
      "distribution": "internal",
      "android": {
        "image": "latest",
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_MODE": "staging",
        "EXPO_PUBLIC_ENVIRONMENT": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://v27oclbqdpqr576iubuqxdumpy0qlviw.lambda-url.us-east-1.on.aws"
      }
    },
    "production": {
      "android": {
        "image": "latest",
        "buildType": "app-bundle"
      }
    }
  }
}
