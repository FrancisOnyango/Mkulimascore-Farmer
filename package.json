{
  "name": "mkulima-farmer",
  "version": "0.1.0",
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-document-picker",
          "expo-image-picker",
          "expo-notifications",
          "expo-speech",
          "react-native-maps",
          "react-native-reanimated",
          "react-native-worklets"
        ]
      }
    }
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "ai:dev": "node services/ask-mkulima/src/server.mjs",
    "ai:test": "node --test services/ask-mkulima/test/*.test.mjs",
    "prebuild": "expo prebuild --clean",
    "export:web": "expo export --platform web",
    "build:preview": "eas build -p android --profile preview",
    "build:staging": "eas build -p android --profile staging",
    "build:production": "eas build -p android --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "^57.0.0",
    "@expo/vector-icons": "^15.1.1",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.16",
    "expo-crypto": "^57.0.0",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-location": "~57.0.16",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.14",
    "expo-router": "~57.0.16",
    "expo-secure-store": "^57.0.0",
    "expo-speech": "~14.0.7",
    "expo-sqlite": "^57.0.0",
    "expo-status-bar": "^57.0.0",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  }
}
